{
  "$comment": "Command registry. Adding a command = one entry here + a prompt file. No code changes.",
  "defaultAutoCommand": "/claude-auto",
  "commands": {
    "/pi": "pi",
    "/pi-auto": "pi-auto",
    "/claude": "claude",
    "/claude-auto": "claude-auto"
  },
  "profiles": {
    "pi": {
      "engine": "pi",
      "prompt": "comment.md",
      "flags": ["--thinking", "medium"]
    },
    "pi-auto": {
      "engine": "pi",
      "prompt": "auto.md",
      "flags": ["--thinking", "medium"]
    },
    "claude": {
      "engine": "claude",
      "prompt": "comment.md",
      "flags": []
    },
    "claude-auto": {
      "engine": "claude",
      "prompt": "auto.md",
      "flags": []
    }
  }
}
