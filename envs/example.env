# Copy to envs/<repo>.env (git-ignored) and fill in.
# Classic PAT with `repo` scope (and `workflow` if pi should touch workflows).
# Used only to obtain runner registration tokens; it is not exposed to jobs.
GH_PAT=ghp_xxxxxxxxxxxxxxxxxxxx
REPO_URL=https://github.com/mhrsh-dev/cicd-runner-lib
# Prefix for runner names, so several PCs are distinguishable in the GitHub UI.
RUNNER_PREFIX=thinkpad
